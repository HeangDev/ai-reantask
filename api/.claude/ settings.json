{
    "permissions": {
        "allow": [
            "Bash(./mvnw:*)",
            "Bash(./gradlew:*)",
            "Bash(mvn:*)",
            "Bash(gradle:*)",
            "Bash(docker compose:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git branch:*)",
            "Bash(git add:*)",
            "Bash(git commit:*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.local)",
            "Read(./.env.production)",
            "Read(./secrets/**)",
            "Bash(rm -rf:*)",
            "Bash(git push --force:*)",
            "Bash(git push -f:*)",
            "Bash(git reset --hard:*)",
            "Bash(curl:*)",
            "Bash(wget:*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.py\""
                    }
                ]
            }
        ]
    }
}