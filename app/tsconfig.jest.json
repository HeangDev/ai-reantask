{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "rootDir": ".",
    "allowJs": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "types": ["jest", "node", "@testing-library/jest-dom", "jest-axe"]
  },
  "include": ["src"]
}
