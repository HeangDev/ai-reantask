VITE_API_URL=http://localhost:8080

# Set to true to show sample classes (read-only) instead of calling the classes API.
VITE_USE_MOCKS=false

# Google sign-in: the OAuth 2.0 Web client ID (public). Leave empty to hide the Google button. Must match GOOGLE_CLIENT_ID in the API.
VITE_GOOGLE_CLIENT_ID=
